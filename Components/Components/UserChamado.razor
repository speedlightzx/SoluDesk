@using System.ComponentModel.DataAnnotations
@rendermode InteractiveServer

<div class="userChamado @(selectedId == id ? "selectedChamado" : "")" @onclick="Click">
    <h1>@username</h1>
</div>

@code {
    [Parameter]
    [EditorRequired] 
    [Required]
    public string username { get; set; }

    [Parameter]
    [EditorRequired] 
    [Required]
    public string problemDescription { get; set; }

    [Parameter]
    public EventCallback<(string problemDescription, int selectedId, string email, int id)> OnSelected { get; set; }

    [Parameter]
    public int? selectedId { get; set; }

    [Parameter]
    [EditorRequired] 
    [Required]
    public string email { get; set; } = string.Empty;
    
    [Parameter]
    [EditorRequired] 
    [Required]
    public int id { get; set; }

    private async Task Click() 
    {
       await OnSelected.InvokeAsync((problemDescription, id, email, id));
    }
}