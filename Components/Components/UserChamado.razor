@using System.ComponentModel.DataAnnotations
@rendermode InteractiveServer

<div class="userChamado @(selected == username ? "selectedChamado" : "")" @onclick="Click">
    <h1>@username</h1>
</div>

@code {
    [Parameter]
    [EditorRequired] 
    [Required]
    public string username { get; set; }

    [Parameter]
    [EditorRequired] 
    [Required]
    public string problemDescription { get; set; }

    [Parameter]
    public EventCallback<(string problemDescription, string username)> OnSelected { get; set; }

    [Parameter]
    public string? selected { get; set; }

    private async Task Click() 
    {
       await OnSelected.InvokeAsync((problemDescription, username));
    }
}