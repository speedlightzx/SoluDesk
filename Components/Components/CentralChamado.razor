@using System.ComponentModel.DataAnnotations
<tr>
    <td>@status</td>
    <td>@problem</td>
    <td>@user</td>
    <td>
        <div class="technicalAndButton dropdown">
            <h1>@tecnico</h1>
            <button class="dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">V</button>
            <ul class="dropdown-menu">
                <li> <span class="dropdown-item">Allan</span> </li>
                <li> <span class="dropdown-item">Kaleb</span> </li>
                <li> <span class="dropdown-item">Igor</span> </li>
                <li> <span class="dropdown-item">Miguel</span> </li>
                <li> <span class="dropdown-item">Matheus</span> </li>
            </ul>
        </div>
    </td>
    <td>@priority</td>
</tr>

@code {
    [Parameter]
    [EditorRequired] 
    [Required]
    public string status { get; set; }

    [Parameter]
    [EditorRequired] 
    [Required]
    public string problem { get; set; }

    [Parameter]
    [EditorRequired] 
    [Required]
    public string user { get; set; }

    [Parameter]
    [EditorRequired] 
    [Required]
    public string tecnico { get; set; }

    [Parameter]
    [EditorRequired] 
    [Required]
    public string priority { get; set; }
}