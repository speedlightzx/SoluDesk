@page "/home"


<HeaderAndLogout></HeaderAndLogout>

<div class="containerPrincipal">

    <div class="principal">
        <div class="search">
            <label>Como podemos ajudar?</label>
            <div>
                <input type="text">
                <img src="/images/searchIcon.png" alt="search">
            </div>
        </div>
        <div class="termsAndUse">
            <p>Termos de Uso</p>
            <p>Modo de uso</p>
        </div>
    </div>

    <form class="problemNotFound" method="post">
    
        <h1 class="notFoundText">Não encontrou o que precisava?</h1>
        <div class="support">
            <h1>Envie seu problema para a equipe <br /> de suporte:</h1>
            <div>
                <input type="email" placeholder="E-mail:">
                <input type="text" placeholder="Assunto:">
                <textarea placeholder="Descreva seu problema:" />
            </div>
            <button type="submit">Enviar</button>
        </div>
    
    </form>

</div>