@page "/problem"
@inject NavigationManager navigationManager
@rendermode InteractiveServer

<Header></Header>
<PageTitle>@title</PageTitle>

<div class="containerPrincipal">

    <div class="comeBack">
        <img src="/images/seta.png" alt="" @onclick="redirect">
    </div>
    <div class="problemBox">
        <h1>@title</h1>
        <div class="problemDescription">
            <p>@desc</p>
        </div>
        @if(!string.IsNullOrEmpty(solution)) 
        {
        <div class="solution">
            <h1>Solução:</h1>
            <p>@solution</p>
        </div>
        }
        <div class="utilButtons">
            <button>Essa resposta foi útil.</button>
            <button>Essa resposta não foi útil.</button>
        </div>
    </div>

</div>

@code {

    [Parameter]
    [SupplyParameterFromQuery(Name = "title")]
    public string? title { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "desc")]
    public string? desc { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "solution")]
    public string? solution { get; set; }

    public void redirect()
    {
        navigationManager.NavigateTo("/home");
    }
}