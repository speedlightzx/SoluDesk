@page "/chamados"
@rendermode InteractiveServer

<header>
    <div class="buttons">
        <button id="@(showMyChamados ? "selectedButton" : "")"
        @onclick="selectHeaderButton">
        Meus chamados
        </button>

        <button id="@(!showMyChamados ? "selectedButton" : "")"
        @onclick="selectHeaderButton">
        Central
        </button>
    </div>

    <div class="logout">
        <button>Log out</button>
    </div>
</header>

<div class="containerPrincipal">
    @if(showMyChamados) {
    <aside class="chamadosSidebar">
        <ul>
            <UserChamado username="componente" selected="@selectedChamadoUsername" problemDescription="teste componente" OnSelected="selectChamado"></UserChamado>
            <UserChamado username="pedro" selected="@selectedChamadoUsername" problemDescription="teste pedro" OnSelected="selectChamado"></UserChamado>
            <UserChamado username="joao" selected="@selectedChamadoUsername" problemDescription="teste joao" OnSelected="selectChamado"></UserChamado>
            <UserChamado username="arthur" selected="@selectedChamadoUsername" problemDescription="teste arthur" OnSelected="selectChamado"></UserChamado>
            <UserChamado username="mekkmk12312" selected="@selectedChamadoUsername" problemDescription="teste we213232x" OnSelected="selectChamado"></UserChamado>
        </ul>
        @if(showAtribuirChamado) 
        {
        <div>
            <div class="atribuirChamado">
                <h1>Atribuir o chamado</h1>
            </div>   
        </div>
        }
    </aside>
    @if(showAtribuirChamado) 
    {
    <div class="chamadoDescription">
        <div class="chamadoBox">
            <div class="problem">
                <p>"Descrição do problema... @problem"</p>
            </div>
            <div class="sendResponse">
                <textarea @bind="response" placeholder="Enviar Resposta"/>
                <button>Enviar</button>
            </div>
        </div>
    </div>
    }
    } else {
        <table class="table table-bordered custom-table">
            <thead>
                <tr>
                    <th>Status</th>
                    <th>Problema</th>
                    <th>Usuário</th>
                    <th>Técnico</th>
                    <th>Prioridade</th>
                </tr>
            </thead>
            <tbody>
                    <CentralChamado 
                    user="juliana cardoso"
                    problem="Hardware"
                    priority="Alta"
                    status="Concluído"
                    tecnico="Kaleb" />

                    <CentralChamado 
                    user="ricardo carvalho"
                    problem="software"
                    priority="média"
                    status="aguardando"
                    tecnico="Miguel" />

                    <CentralChamado 
                    user="fausto silva"
                    problem="login"
                    priority="baixa"
                    status="concluído"
                    tecnico="Allan" />

                    <CentralChamado 
                    user="joao pedro"
                    problem="conexao"
                    priority="alta"
                    status="aguardando"
                    tecnico="Matheus" />
            </tbody>
        </table>
    }
</div>

@code {
    private bool showAtribuirChamado = false;
    private string problem = string.Empty;
    private string response = string.Empty;

    private string selectedChamadoUsername = string.Empty;

    private bool showMyChamados = true;

    private void selectChamado((string problemDescription, string username) data) 
    {
        selectedChamadoUsername = data.username;
        showAtribuirChamado = true;
        problem = data.problemDescription;
        response = string.Empty;
    }

    private void selectHeaderButton() 
    {
        response = string.Empty;
        problem = string.Empty;
        showAtribuirChamado = false;
        selectedChamadoUsername = string.Empty;
        showMyChamados = !showMyChamados;
    }
}