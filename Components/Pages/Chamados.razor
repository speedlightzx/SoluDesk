@page "/chamados"
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@rendermode InteractiveServer
@inject NavigationManager navigationManager
@inject IHttpClientFactory httpClient
@inject ProtectedLocalStorage localStorage
@inject IJSRuntime js

<header>
    <div class="buttons">
        <button id="@(currentPage == "chamados" ? "selectedButton" : "")"
        @onclick='() => selectHeaderButton("chamados")'>
        Meus chamados
        </button>

        <button id="@(currentPage != "chamados" ? "selectedButton" : "")"
        @onclick='() => selectHeaderButton("central")'>
        Central
        </button>
    </div>

    <div class="logout">
        <button @onclick="logout">Log out</button>
    </div>
</header>

<div class="containerPrincipal">
    @if(currentPage == "chamados") {
    <aside class="chamadosSidebar">
        <ul>
            @foreach (UserChamado chamado in userChamados) 
            {
                <UserChamado 
                username="@chamado.username"
                problemDescription="@chamado.problemDescription"
                OnSelected="selectChamado"
                selectedId="@selectedId"
                email="@chamado.email"
                id="@chamado.id"
                 />
            }
        </ul>
        @if(showAtribuirChamado) 
        {
        <div>
            <div class="atribuirChamado @(atribuirChamado ? "selectAtribuirChamado" : "")"
            @onclick="clickAtribuirChamado">
                <h1>Atribuir o chamado</h1>
            </div>   
        </div>
        }
    </aside>
    @if(showAtribuirChamado) 
    {
    <div class="chamadoDescription">
        <div class="chamadoBox">
            @if(submited && !string.IsNullOrEmpty(message)) {
                <MessageWithOkButton pressOk="pressedOk" message="@message"/>
            } else if(atribuirChamado) {
                <div class="selectNewTecnico">
                    <h1>Técnicos:</h1>
                    <ul>
                        <li class="@verifySelectedTecnico("Igor")" @onclick='() => selectTecnico("Igor")'>Igor</li>
                        <li class="@verifySelectedTecnico("Kaleb")" @onclick='() => selectTecnico("Kaleb")'>Kaleb</li>
                        <li class="@verifySelectedTecnico("Allan")" @onclick='() => selectTecnico("Allan")'>Allan</li>
                        <li class="@verifySelectedTecnico("Matheus")" @onclick='() => selectTecnico("Matheus")'>Matheus</li>
                        <li class="@verifySelectedTecnico("Guilherme")" @onclick='() => selectTecnico("Guilherme")'>Guilherme</li>
                        <li class="@verifySelectedTecnico("Miguel")" @onclick='() => selectTecnico("Miguel")'>Miguel</li>
                        @if(!string.IsNullOrEmpty(selectedTecnico)) 
                        {
                        <div class="indicator"></div>
                        }
                    </ul>
                    <button @onclick="submitNewTecnico">Enviar</button>
                </div>
            } else if(int.IsPositive(selectedId)){
                <div class="problem">
                    <p>"Descrição do problema... @problem"</p>
                </div>
                <div class="sendResponse">
                    <textarea @bind="response" placeholder="Enviar Resposta"/>
                    <button @onclick="submitChamado">Enviar</button>
                </div>
            }
        </div>
    </div>
    }
    } else {
        <table class="table table-bordered custom-table">
            <thead>
                <tr>
                    <th>Status</th>
                    <th>Problema</th>
                    <th>Usuário</th>
                    <th>Técnico</th>
                    <th>Prioridade</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var chamado in centralChamados ) {
                    <CentralChamado 
                    user=@chamado.user
                    problem=@chamado.problem
                    priority=@chamado.priority
                    status=@chamado.status
                    tecnico=@chamado.tecnico
                    id=@chamado.id
                    changeButton=changeTechnicalButton
                    refreshTecnico="getTecnicoChamados"
                    refreshCentral="getCentralChamados"
                    />
                }
            </tbody>
        </table>
    }
</div>

@code {

    protected override async Task OnAfterRenderAsync(bool firstRender) 
    {
        if(firstRender == false) return;

        await getTecnicoChamados();
        await getCentralChamados();
        var isAdmin = await localStorage.GetAsync<bool>("adm");
        if(isAdmin.Success && isAdmin.Value == true) changeTechnicalButton = true;
    }

    private List<UserChamado> userChamados = new List<UserChamado>();

    private List<CentralChamado> centralChamados = new List<CentralChamado>();

    private async Task getTecnicoChamados()
    {
        var http = httpClient.CreateClient("api");

        var token = await localStorage.GetAsync<string>("session_token");
        http.DefaultRequestHeaders.Authorization = new(token.Value!);

        var res = await http.GetAsync("/chamados");

        if(res.IsSuccessStatusCode)
        {
            var chamados = await res.Content.ReadFromJsonAsync<ChamadosResponse>();

            userChamados = chamados.chamados.Select(c => new UserChamado
            {
                username = c.user.nome,
                problemDescription = c.description,
                OnSelected = EventCallback.Factory.Create<(string problemDescription, int selectId, string email, int id)>(
                    this, selectChamado
                ),
                selectedId = selectedId,
                email = c.user.email,
                id = c.id
            }).ToList();

            StateHasChanged();
        }
    }

    private async Task getCentralChamados()
    {
        var http = httpClient.CreateClient("api");

        var token = await localStorage.GetAsync<string>("session_token");
        http.DefaultRequestHeaders.Authorization = new(token.Value!);

        var res = await http.GetAsync("/chamados/central");

        if(res.IsSuccessStatusCode)
        {
            var chamados = await res.Content.ReadFromJsonAsync<CentralResponse>();

            centralChamados = chamados.chamados.Select(c => new CentralChamado
            {
                user = c.user,
                problem = c.category,
                priority = c.priority,
                tecnico = c.technicalResponsible ?? c.defaultResponsible,
                status = c.status,
                id = c.id
            }).ToList();

            StateHasChanged();
        }
    }

    private bool changeTechnicalButton = false;
    private bool showAtribuirChamado = false;
    private string problem = string.Empty;
    private string response = string.Empty;

    private int selectedId { get; set; }

    private string currentPage = "chamados";

    private bool atribuirChamado = false;

    private string selectedTecnico = string.Empty;

    private bool submited = false;

    private string message = string.Empty;

    private string email = string.Empty;
    private int id { get; set; }

    private void selectTecnico(string tec) 
    {
        selectedTecnico = tec;
    }

    private string verifySelectedTecnico(string name) 
    {

        if(selectedTecnico.ToLower() == name.ToLower()) return "selectedTecnico";

        return "";
    }

    private void clickAtribuirChamado() 
    {
        atribuirChamado = !atribuirChamado;
    }

    private void selectChamado((string problemDescription, int selectId, string email, int id) data) 
    {
        atribuirChamado = false;
        selectedTecnico = string.Empty;
        selectedId = data.selectId;
        showAtribuirChamado = true;
        problem = data.problemDescription;
        response = string.Empty;
        this.email = data.email;
        this.id = data.id;
    }

    private void resetFields() 
    {
        response = string.Empty;
        problem = string.Empty;
        showAtribuirChamado = false;
        selectedId = 0;
    }

    private void selectHeaderButton(string page)
    {
        currentPage = page;
    }

    private async Task submitNewTecnico()
    {
        if(string.IsNullOrEmpty(selectedTecnico)) {
            await js.InvokeVoidAsync("alert", "Você precisa selecionar um novo técnico!");
            return;
        }

        var http = httpClient.CreateClient("api");

        var token = await localStorage.GetAsync<string>("session_token");
        http.DefaultRequestHeaders.Authorization = new(token.Value!);

        var res = await http.PutAsJsonAsync("/chamados/distributeChamado", new
        {
            tecnico=selectedTecnico, id
        });

        if(res.IsSuccessStatusCode)
        {
            var chamado = userChamados.Find(c => c.id == selectedId);
            userChamados.Remove(chamado!);
            message = "Atendimento Distribuido!";
            submited = true;
        }

        await getCentralChamados();
    }

    private void pressedOk() 
    {
        submited = false;
        atribuirChamado = false;
        selectedTecnico = string.Empty;
        selectedId = 0;
        showAtribuirChamado = false;
        problem = string.Empty;
        response = string.Empty;
        message = string.Empty;
    }

    private async Task submitChamado() 
    {
        if(!int.IsPositive(selectedId)) return;
        if(string.IsNullOrEmpty(response)) {
            await js.InvokeVoidAsync("alert", "Você precisa dar uma resposta para esse chamado!");
            return;
        }

        var http = httpClient.CreateClient("api");

        var token = await localStorage.GetAsync<string>("session_token");
        http.DefaultRequestHeaders.Authorization = new(token.Value!);

        var res = await http.PutAsJsonAsync("/chamados/resolve", new
        {
            email, id, solution=response
        });

        if(res.IsSuccessStatusCode)
        {
            var chamado = userChamados.Find(c => c.id == selectedId);
            userChamados.Remove(chamado!);
            message = "Atendimento Realizado!";
            submited = true;
        }

        await getCentralChamados();
    }

    private async Task logout()
    {
        await localStorage.DeleteAsync("session_token");
        navigationManager.NavigateTo("/");
    }
}