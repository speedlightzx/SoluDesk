@page "/cadastro"
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject NavigationManager navigationManager
@rendermode InteractiveServer
@inject IHttpClientFactory httpClient
@inject ProtectedLocalStorage localStorage
@inject IJSRuntime js

<Header></Header>
<PageTitle>Cadastre-se</PageTitle>

<div class="container">

    <div class="containerSignUp">

    <h1>Cadastre-se</h1>

    <form @onsubmit="submit">

        <div class="required">
            <input @bind="username" type="text" placeholder="Nome de usuario:">
            <input @bind="email" type="email" placeholder="E-mail:">
            <input type="email" placeholder="Confirmar e-mail:">
            <input @bind="senha" type="password" placeholder="Senha:">
            <input type="password" placeholder="Confirmar senha:">
        </div>

        <div class="terms">
            <input type="checkbox">
            <label>Eu li e aceito os termos de uso</label>
        </div>

        <div class="submitButtons">
            <input type="submit" value="Cadastrar">
            <input type="button" @onclick="redirect" value="Entrar">
        </div>
    </form>
    
    </div>
</div>

@code {

    private string email { get; set; } = string.Empty;
    private string senha { get; set; } = string.Empty;
    private string username { get; set; } = string.Empty;

    private void redirect()
    {
        navigationManager.NavigateTo("/");
    }
    private async Task submit()
    {
        var http = httpClient.CreateClient("api");
        var res = await http.PostAsJsonAsync("/auth/cadastro",
        new { email, senha, username }
        );
        
        if(res.IsSuccessStatusCode)
        {
            navigationManager.NavigateTo("/");
            await js.InvokeVoidAsync("alert", "Cadastro realizado com sucesso.");
        }

        SignupResponse? data = await res.Content.ReadFromJsonAsync<SignupResponse>();
        await js.InvokeVoidAsync("alert", data!.error);
    }
}